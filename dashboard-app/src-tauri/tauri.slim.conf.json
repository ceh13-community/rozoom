{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": ["slim"]
    }
  },
  "bundle": {
    "externalBin": ["binaries/rozoom-kubectl", "binaries/rozoom-helm"],
    "resources": { "../../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md" }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ceh13-community/rozoom/releases/latest/download/latest-slim.json"
      ]
    }
  }
}
