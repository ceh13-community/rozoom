# Maintainer: ROZOOM team (https://github.com/ceh13-community/rozoom/issues)

pkgname=rozoom-bin
pkgver=0.26.1
pkgrel=1
pkgdesc="ROZOOM K8s Linter IDE: desktop Kubernetes manager and linter, client-side only (official binary, slim build)"
arch=('x86_64')
url="https://rozoom.app"
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
optdepends=('noto-fonts-emoji: icons in the UI')
provides=('rozoom')
conflicts=('rozoom')
options=('!strip' '!debug')

_deb="ROZOOM_K8s_Linter_IDE_${pkgver}_amd64_slim.deb"
source=("${_deb}::https://github.com/ceh13-community/rozoom/releases/download/app-v${pkgver}/${_deb}"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/ceh13-community/rozoom/app-v${pkgver}/LICENSE")
noextract=("${_deb}")
sha256sums=('0f9d0fc8bafca7f668c8334e4baaf8166073638a2495620d8b78df07ad22d239'
            'cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30')

package() {
  # The .deb is an ar archive; its data.tar.gz already carries the /usr tree
  # (binary, bundled kubectl and helm, .desktop, hicolor icons, THIRD-PARTY-LICENSES.md).
  bsdtar -xOf "${srcdir}/${_deb}" data.tar.gz | bsdtar -xf - -C "${pkgdir}"

  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  ln -s /usr/lib/ROZOOM_K8s_Linter_IDE/THIRD-PARTY-LICENSES.md \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-LICENSES.md"
}
